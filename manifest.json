{
  "manifest_version": 3,
  "name": "LocalLens — Local AI Image Detector",
  "version": "1.0.0",
  "description": "Detects computer-generated images (AI) entirely in your browser using WebGPU. No cloud, no uploads, private by design.",
  "minimum_chrome_version": "113",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "LocalLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/ort.all.min.js", "content/detector.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*.wasm", "lib/*.mjs", "model/*.onnx", "model/*.onnx.gz"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
