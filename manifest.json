{
  "manifest_version": 3,
  "name": "AI Block — Block Computer-Generated Images",
  "version": "1.1.8",
  "description": "AI Block detects and blocks computer-generated (AI) images entirely in your browser using WebGPU. No cloud, no uploads, private by design.",
  "minimum_chrome_version": "113",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI Block",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/ort.all.min.js", "content/detector.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*.js", "lib/*.wasm", "lib/*.mjs", "model/*.onnx", "model/*.onnx.gz"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
